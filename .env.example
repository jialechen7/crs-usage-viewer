PORT=3001
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Optional: only needed if you want to look up API keys by their raw cr_xxx token.
# Must match the ENCRYPTION_KEY in the CRS service .env (32-char hex).
# If empty, /stats/key/cr_xxx will return 500; /stats/key/<name> still works.
ENCRYPTION_KEY=
API_KEY_PREFIX=cr_
