PORT=3001
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Optional: only needed if you want to look up API keys by their raw cr_xxx token.
# Must match the ENCRYPTION_KEY in the CRS service .env (32-char hex).
# If empty, /stats/key/cr_xxx will return 500; /stats/key/<name> still works.
ENCRYPTION_KEY=
API_KEY_PREFIX=cr_

# Timezone used by CRS when writing usage:cost:hourly:* keys.
# MUST match CRS service .env's TIMEZONE_OFFSET. Default 8 (UTC+8 Beijing).
# Mismatch → all hourly cost queries return 0 because the date:hour we
# build won't line up with what CRS wrote.
TIMEZONE_OFFSET=8

# Default false. Utilization drops are noisy for rolling 7d windows, so do not
# infer quota resets from them unless you explicitly accept that risk.
ENABLE_UTILIZATION_DROP_RESETS=false
# Optional JSON file for trusted manual reset boundaries. Keys are
# "<backend>:<accountId>:<windowType>", values are ISO timestamps or
# {"resetAt":"..."} objects. Overrides outside the nominal window are ignored.
QUOTA_RESET_OVERRIDES_PATH=.quota-reset-overrides.json
# Optional write-token for /stats/reset-overrides. If set, send it as
# Authorization: Bearer <token> or x-admin-token.
RESET_OVERRIDE_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# crs2 (sub2api) backend — reads PostgreSQL, served under /stats/crs2/*.
# Leave ENABLE_CRS2 unset/false for a pure-CRS deployment (pg not required).
# ---------------------------------------------------------------------------
ENABLE_CRS2=false
PG_HOST=localhost
PG_PORT=5432
PG_USER=sub2api
PG_PASSWORD=
PG_DATABASE=sub2api
PG_SSL=false
# Raw API key prefix for token lookup on /stats/crs2/key/<token> (sub2api default sk-).
CRS2_API_KEY_PREFIX=sk-
